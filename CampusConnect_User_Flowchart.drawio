              <mxPoint x="580" y="352" />
              <mxPoint x="210" y="352" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eb1_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="b1_scen" target="b1_act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="b1_act" target="b1_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BRANCH 2: SCENARIO 5 (FLAG) ==================== -->
        <mxCell id="b2_scen" value="&lt;b&gt;Scenario 5: Sharing an Unverified Rumor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#92400E;&quot;&gt;Anonymous grade manipulation claim naming a staff member without proof&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;fontColor=#0F172A;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="380" width="300" height="64" as="geometry" />
        </mxCell>

        <mxCell id="b2_cw" value="&lt;b&gt;Screen 3: Content Warning Modal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#64748B;&quot;&gt;Alerts poster of unverified claim risk; offers Edit, Cancel, or Review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="480" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b2_hr" value="&lt;b&gt;Screen 4: Human Moderator Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#64748B;&quot;&gt;Checks if corroborating evidence or official investigation exists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="576" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b2_out" value="&lt;b&gt;Outcome 2: Flag for Review &amp;amp; Verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#92400E;&quot;&gt;Questionable accusations require human review before final decision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#B45309;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="672" width="300" height="64" as="geometry" />
        </mxCell>

        <!-- Branch 2 Edges -->
        <mxCell id="eb2_0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="gate" target="b2_scen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="b2_scen" target="b2_cw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="b2_cw" target="b2_hr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="b2_hr" target="b2_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BRANCH 3: SCENARIO 11 (RESTRICT) ==================== -->
        <mxCell id="b3_scen" value="&lt;b&gt;Scenario 11: Reposting with Added Accusation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#991B1B;&quot;&gt;User shares a post &amp;amp; authors a new embezzlement claim known to be false&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontColor=#0F172A;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="380" width="300" height="64" as="geometry" />
        </mxCell>

        <mxCell id="b3_cw" value="&lt;b&gt;Screen 3: Content Warning Modal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#64748B;&quot;&gt;Flags newly authored crime imputation against identifiable employee&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="480" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b3_hr" value="&lt;b&gt;Screen 4: Human Moderator Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#64748B;&quot;&gt;Separates sharing from new false statement; confirms Cyber Libel elements&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="576" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b3_out" value="&lt;b&gt;Outcome 3: Screen 5 — Restricted &amp;amp; Appeal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#991B1B;&quot;&gt;Knowingly false accusation removed after review, with explanation &amp;amp; appeal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#B91C1C;fontFamily=Helvetica;fontSize=12.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="672" width="300" height="64" as="geometry" />
        </mxCell>

        <!-- Branch 3 Edges -->
        <mxCell id="eb3_0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gate" target="b3_scen">
